# Copy to .env (untracked). Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Set exactly ONE of the two keys above. It runs both chat and categorization:
# OpenAI (Decisions API + chat) or Claude (categorizer + chat). Setting both is an error.
# CATEGORIZER=none turns categorization off.
CATEGORIZER=auto
DECISIONS_MODEL=gpt-6-luna
DECISIONS_THRESHOLD=0.6
# the Claude categorizer (used when only ANTHROPIC_API_KEY is set)
CATEGORIZATION_MODEL=claude-haiku-4-5-20251001
# Leave CHAT_MODEL empty for the provider's default (claude-sonnet-5-5 or gpt-5.5).
CHAT_MODEL=
POSTGRES_PASSWORD=cfo-local-dev
# Original statement narrations are stored encrypted. Under Docker the key is generated into a
# volume on first run. To manage it yourself, set NARRATION_KEY (a Fernet key: python -c
# "from cfo.vault import generate_key; print(generate_key())"); back it up, because without it
# the app falls back to the redacted text.
NARRATION_KEY=

# Hosts the API answers to, comma separated. Leave empty for localhost, 127.0.0.1 and the web
# service. Add a name only if you reach the app by another one; never expose the API to a network.
ALLOWED_HOSTS=
