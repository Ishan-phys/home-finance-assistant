# Copy to .env (untracked). Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Set exactly ONE of the two keys above. It runs both chat and categorization:
# OpenAI (Decisions API + chat) or Claude (categorizer + chat). Setting both is an error.
# CATEGORIZER=none turns categorization off.
CATEGORIZER=auto
DECISIONS_MODEL=gpt-6-luna
DECISIONS_THRESHOLD=0.6
# the Claude categorizer (used when only ANTHROPIC_API_KEY is set)
CATEGORIZATION_MODEL=claude-haiku-4-5-20251001
# Leave CHAT_MODEL empty for the provider's default (claude-sonnet-5-5 or gpt-5.5).
CHAT_MODEL=
POSTGRES_PASSWORD=cfo-local-dev

# Sign-in. The owner signs in with this username and password; only a hash of the password is kept.
# OWNER_PASSWORD_HASH: run `uv run python -m cfo.api.auth`, type a password, and paste the printed
#   hash here inside single quotes. The hash contains $ signs, and without the quotes Docker
#   Compose replaces them with nothing.
# SESSION_SECRET: at least 32 random characters, for example
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sessions last 5 days. Leave SESSION_COOKIE_SECURE=true unless you reach the app over plain HTTP.
OWNER_USERNAME=
OWNER_PASSWORD_HASH=
SESSION_SECRET=
SESSION_COOKIE_SECURE=true
# Original statement narrations are stored encrypted. Under Docker the key is generated into a
# volume on first run. To manage it yourself, set NARRATION_KEY (a Fernet key: python -c
# "from cfo.vault import generate_key; print(generate_key())"); back it up, because without it
# the app falls back to the redacted text.
NARRATION_KEY=

# Extra host names the API answers to, comma separated, added to localhost, 127.0.0.1 and the web
# service. Set it to the name you browse by (for example cfo.your-tailnet.ts.net) so sign-in works
# from there. Never publish the API port itself to a network.
ALLOWED_HOSTS=
