# Copy to .env (untracked). Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Set exactly ONE of the two keys above. It runs both chat and categorization:
# OpenAI (Decisions API + chat) or Claude (categorizer + chat). Setting both is an error.
# CATEGORIZER=none turns categorization off.
CATEGORIZER=auto
DECISIONS_MODEL=gpt-6-luna
DECISIONS_THRESHOLD=0.6
# the Claude categorizer (used when only ANTHROPIC_API_KEY is set)
CATEGORIZATION_MODEL=claude-haiku-4-5-20251001
# Leave CHAT_MODEL empty for the provider's default (claude-sonnet-5-5 or gpt-5.5).
CHAT_MODEL=
POSTGRES_PASSWORD=cfo-local-dev
